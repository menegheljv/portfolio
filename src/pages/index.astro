---
import Header from '../components/Header.astro';
import Profile from '../components/Profile.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>João Victor Meneghel | Data Storyteller</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="João Victor Meneghel, Data Storyteller and comms &amp; growth strategist working at the intersection of public administration, data and AI-driven storytelling." />
    <meta name="theme-color" content="#ffffff" />
    <meta name="application-name" content="João Victor Meneghel" />
    <meta property="og:title" content="João Victor Meneghel | Data Storyteller" />
    <meta property="og:description" content="Comms & growth strategist working across public administration, data storytelling and AI governance." />
    <meta property="og:image" content={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg?v=3`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.svg?v=3`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,650;12..96,700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <Profile />
    <Footer />
    <script>
      const links = [...document.querySelectorAll('.jump a')];
      const byId = new Map(links.map((a) => [a.getAttribute('href').slice(1), a]));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((a) => a.classList.remove('active'));
            byId.get(e.target.id)?.classList.add('active');
          }
        });
      }, { rootMargin: '-35% 0px -60% 0px' });
      byId.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
    </script>
  </body>
</html>
