---
import Header from '../components/Header.astro';
import Profile from '../components/Profile.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>João Victor Meneghel | Data Storyteller</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta id="meta-desc" name="description" content="João Victor Meneghel, Data Storyteller and comms &amp; growth strategist working at the intersection of public administration, data and AI-driven storytelling." />
    <meta name="theme-color" content="#ffffff" />
    <meta name="application-name" content="João Victor Meneghel" />
    <meta property="og:title" content="João Victor Meneghel | Data Storyteller" />
    <meta property="og:description" content="Comms & growth strategist working across public administration, data storytelling and AI governance." />
    <meta property="og:image" content={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg?v=4`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.svg?v=4`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      try {
        var saved = localStorage.getItem('lang');
        if (saved === 'pt' || saved === 'en' || saved === 'es' || saved === 'zh') {
          document.documentElement.dataset.lang = saved;
          document.documentElement.lang = saved === 'pt' ? 'pt-BR' : saved === 'zh' ? 'zh-Hans' : saved;
        }
      } catch (e) {}
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,650;12..96,700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <Profile />
    <Footer />
    <script>
      const T = {
        en: {
          title: 'João Victor Meneghel | Data Storyteller',
          desc: 'João Victor Meneghel, Data Storyteller and comms & growth strategist working at the intersection of public administration, data and AI-driven storytelling.',
          nav: 'Sections',
        },
        pt: {
          title: 'João Victor Meneghel | Data Storyteller',
          desc: 'João Victor Meneghel, Data Storyteller e estrategista de comunicação e crescimento, atuando entre administração pública, dados e narrativa com IA.',
          nav: 'Seções',
        },
        es: {
          title: 'João Victor Meneghel | Data Storyteller',
          desc: 'João Victor Meneghel, Data Storyteller y estratega de comunicación y crecimiento, que actúa entre administración pública, datos y narrativa con IA.',
          nav: 'Secciones',
        },
        zh: {
          title: 'João Victor Meneghel | Data Storyteller',
          desc: 'João Victor Meneghel，数据叙事者（Data Storyteller）与传播及增长策略师，工作于公共行政、数据与 AI 叙事的交汇处。',
          nav: '章节',
        },
      };
      const HTML_LANG = { en: 'en', pt: 'pt-BR', es: 'es', zh: 'zh-Hans' };
      const setLang = (lang, save) => {
        const html = document.documentElement;
        html.dataset.lang = lang;
        html.lang = HTML_LANG[lang];
        document.title = T[lang].title;
        document.getElementById('meta-desc')?.setAttribute('content', T[lang].desc);
        document.querySelector('.jump')?.setAttribute('aria-label', T[lang].nav);
        document.querySelectorAll('[data-set-lang]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setLang === lang)));
        if (save) { try { localStorage.setItem('lang', lang); } catch (e) {} }
      };
      setLang(['pt', 'es', 'zh'].includes(document.documentElement.dataset.lang) ? document.documentElement.dataset.lang : 'en', false);
      document.querySelectorAll('[data-set-lang]').forEach((b) => b.addEventListener('click', () => setLang(b.dataset.setLang, true)));

      const links = [...document.querySelectorAll('.jump a')];
      const byId = new Map(links.map((a) => [a.getAttribute('href').slice(1), a]));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((a) => a.classList.remove('active'));
            byId.get(e.target.id)?.classList.add('active');
          }
        });
      }, { rootMargin: '-35% 0px -60% 0px' });
      byId.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
    </script>
  </body>
</html>
